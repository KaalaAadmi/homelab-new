TZ=Europe/Dublin
APPDATA=${HOME}/volumes
DOMAIN=https://vault.home.example.com
# Same value as VAULTWARDEN_DB_PASSWORD in docker/postgres/.env
DB_PASSWORD=
# true only while you create your own account(s); then set false and invite others from /admin
SIGNUPS_ALLOWED=true
# Admin page token, as an argon2 hash. Make it with:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# Paste the $argon2id... string here with every $ doubled ($ -> $$). Leave empty to disable /admin.
ADMIN_TOKEN=
