{
	email {$ACME_EMAIL}
}

(proxy) {
	reverse_proxy host.docker.internal:{args[0]}
}

# Same, but asks for an Authentik login first. Used for apps that have no login of their own.
# Needs the "homelab-forward-auth" provider in Authentik (README: "Who can reach what").
(protected) {
	route {
		reverse_proxy /outpost.goauthentik.io/* host.docker.internal:9000
		forward_auth host.docker.internal:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid
			trusted_proxies private_ranges
		}
		reverse_proxy host.docker.internal:{args[0]}
	}
}

