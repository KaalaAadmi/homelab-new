APPDATA=${HOME}/volumes

# Every service becomes https://<name>.<HOME_DOMAIN>, e.g. https://jellyfin.home.arnavbhattacharya.com
HOME_DOMAIN=home.arnavbhattacharya.com
ACME_EMAIL=

# Cloudflare API token with permission Zone -> DNS -> Edit for your domain only
# (dash.cloudflare.com -> My Profile -> API Tokens -> "Edit zone DNS" template)
CLOUDFLARE_API_TOKEN=
