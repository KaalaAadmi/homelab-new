TZ=Europe/Dublin
PUID=1000
PGID=1000
APPDATA=${HOME}/volumes
DATA=${HOME}/data

# Same value as PAPERLESS_DB_PASSWORD in docker/postgres/.env (make-env.py fills both)
DB_PASSWORD=
# Random, long. make-env.py generates it.
SECRET_KEY=
BASE_URL=https://docs.home.example.com

# The first admin account, created on first start. Change the password in the web page afterwards.
ADMIN_USER=admin
ADMIN_PASSWORD=
