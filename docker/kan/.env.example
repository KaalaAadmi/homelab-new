# Same value as KAN_DB_PASSWORD in docker/postgres/.env
DB_PASSWORD=
BASE_URL=https://kan.home.example.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# set to true once everyone has an account
DISABLE_SIGN_UP=false

# Optional: sign in with Authentik (create an OAuth2/OpenID provider + application "kan")
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# https://auth.home.example.com/application/o/kan/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
