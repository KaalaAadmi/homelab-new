TZ=Europe/Dublin
MODELS_DIR=${HOME}/volumes/models

# --- LiteLLM ---
# Same value as LITELLM_DB_PASSWORD in docker/postgres/.env
LITELLM_DB_PASSWORD=
# Admin key for LiteLLM's UI and API; must start with sk-.  echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
# Encrypts stored keys. Set once, never change:  echo "sk-$(openssl rand -hex 24)"
LITELLM_SALT_KEY=

# Provider keys (only LiteLLM sees these)
GROQ_API_KEY=
# keep its spending limit at $0 on openrouter.ai until you choose otherwise
OPENROUTER_API_KEY=
# Gemini's free tier trains on what you send: test data only
GEMINI_API_KEY=
# An API key you create in OmniRoute's dashboard after first start, so LiteLLM can call it
OMNIROUTE_API_KEY=

# --- SearXNG ---
SEARXNG_BASE_URL=https://search.home.example.com/
# openssl rand -hex 32
SEARXNG_SECRET=

# --- Open WebUI ---
# A LiteLLM virtual key for Open WebUI, made after LiteLLM starts:
#   curl -s http://localhost:4000/key/generate -H "Authorization: Bearer $LITELLM_MASTER_KEY" \
#     -H 'Content-Type: application/json' -d '{"key_alias":"open-webui"}'
OPENWEBUI_API_KEY=
OPENWEBUI_SECRET_KEY=
# After you've made your account, set this to false and run docker compose up -d again
OPENWEBUI_ENABLE_SIGNUP=true
# Later, to talk to YETI instead of the raw models: http://yeti:8000/v1/openai
OPENWEBUI_API_BASE_URL=http://litellm:4000/v1
