# OmniRoute settings, kept in their own file so OmniRoute never sees LiteLLM's or the provider keys.
# Copy to omniroute.env (cp omniroute.env.example omniroute.env).
# Rules for this homelab: add only API-key providers (Groq, Cerebras, NVIDIA NIM, Cloudflare).
# Do NOT connect subscription logins (Claude, ChatGPT/Codex, Copilot ...) and leave its
# "TLS stealth" and no-account free pools off.
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32
API_KEY_SECRET=
# openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=
# dashboard login; change it after first sign-in
INITIAL_PASSWORD=
BASE_URL=https://omniroute.home.example.com
NEXT_PUBLIC_BASE_URL=https://omniroute.home.example.com
AUTH_COOKIE_SECURE=true
