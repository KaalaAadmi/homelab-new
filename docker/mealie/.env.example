TZ=Europe/Dublin
PUID=1000
PGID=1000
APPDATA=${HOME}/volumes

# Same value as MEALIE_DB_PASSWORD in docker/postgres/.env (make-env.py fills both)
DB_PASSWORD=
BASE_URL=https://recipes.home.example.com
# First visit: log in as changeme@example.com / MyPassword, then change both. Invite the others
# from the admin page; sign-up stays off.
ALLOW_SIGNUP=false

# Optional: AI help through LiteLLM. OPENAI_BASE_URL=http://litellm:4000/v1 and a LiteLLM
# virtual key for Mealie (leave empty to turn it off)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=yeti-fast
