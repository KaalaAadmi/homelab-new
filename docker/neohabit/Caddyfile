# From the Neohabit repo: serve the web app, send /api to the backend.
:80 {
	handle /runtime-config.js {
		root * /srv
		file_server
		header Cache-Control "no-store, no-cache, must-revalidate"
		header Pragma "no-cache"
		header -ETag
	}

	handle_path /api/* {
		encode gzip zstd
		reverse_proxy backend:9000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	encode gzip zstd
}
