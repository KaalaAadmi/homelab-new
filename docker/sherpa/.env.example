# Sherpa (apps/sherpa). ENV-SETUP.md has the step-by-step for each value.
# Keep each value on its own line with nothing after it: comments go on their own lines.
TZ=Europe/Dublin
DATA=${HOME}/data

# Same value as SHERPA_DB_PASSWORD in docker/postgres/.env (make-env.py fills both)
DB_PASSWORD=

# --- Discord -------------------------------------------------------------------------------
# Bot token: discord.com/developers/applications -> Sherpa -> Bot -> Reset Token
DISCORD_TOKEN=
# IDs: Discord -> User Settings -> Advanced -> Developer Mode on, then right-click -> Copy ID
DISCORD_GUILD_ID=
# You. You can always request and run the admin commands (/space, /link).
DISCORD_OWNER_ID=
# People with Admin can run /space and /link. People with Household can request.
DISCORD_ADMIN_ROLE_ID=
DISCORD_HOUSEHOLD_ROLE_ID=
# Where "it's ready" posts go: #now-available
DISCORD_ANNOUNCE_CHANNEL_ID=

# --- Apps (copied from docker/media/.env by make-env.py once you've filled them there) ------
SEERR_API_KEY=
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=
CHAPTARR_API_KEY=
SUWAYOMI_USER=
SUWAYOMI_PASSWORD=
# Mylar3 -> Settings -> Web Interface -> API: enable, generate, copy
MYLAR_API_KEY=

# Optional: which Suwayomi source to search (part of its name, e.g. MangaDex). Empty: the first one.
SUWAYOMI_SOURCE=
# Folders inside the *arr containers (only change these if you changed the media layout)
LIDARR_ROOT_FOLDER=/data/media/music
CHAPTARR_EBOOK_ROOT=/data/media/books
CHAPTARR_AUDIOBOOK_ROOT=/data/media/audiobooks

# --- YETI's access ---------------------------------------------------------------------------
# YETI sends this as "Authorization: Bearer <token>". make-env.py generates it.
SHERPA_API_TOKEN=
# How often (minutes) Sherpa checks what's finished, what's been deleted, and sizes
SYNC_MINUTES=15
