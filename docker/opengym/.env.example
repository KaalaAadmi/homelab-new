APPDATA=${HOME}/volumes

# Must match the address you open it at (through Caddy), or passkey sign-in fails
RP_ID=gym.home.example.com
ORIGIN=https://gym.home.example.com
RP_NAME=openGym

# the first account you create becomes admin
FIRST_USER_ADMIN=true
# nobody else can sign up without an invite
INVITE_ONLY=true
PASSWORD_LOGIN=true
ALLOW_GUEST=false
# its AI coach would send your training data to a cloud model
COACH_DISABLED=true
AUDIT_IP=off
