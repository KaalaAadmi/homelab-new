TZ=Europe/Dublin
APPDATA=${HOME}/volumes
BACKUP_DIR=${HOME}/volumes/postgres-backups

# Admin password for the server itself. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# One password per app (openssl rand -hex 24 each). Each app's own .env repeats its password,
# so the two must match. Leave a line empty to skip that app's database.
AUTHENTIK_DB_PASSWORD=
MINIFLUX_DB_PASSWORD=
SPEEDTEST_DB_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
FIREFLY_DB_PASSWORD=
LITELLM_DB_PASSWORD=
KAN_DB_PASSWORD=
N8N_DB_PASSWORD=
NEOHABIT_DB_PASSWORD=
VAULTWARDEN_DB_PASSWORD=
SHERPA_DB_PASSWORD=
PAPERLESS_DB_PASSWORD=
MEALIE_DB_PASSWORD=
YETI_DB_PASSWORD=
# YETI's development copy (fake data only), on the same server
YETI_DEV_DB_PASSWORD=
