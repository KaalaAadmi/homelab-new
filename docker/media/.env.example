TZ=Europe/Dublin
PUID=1000
PGID=1000
APPDATA=${HOME}/volumes
DATA=${HOME}/data

# NordVPN "service credentials" (NOT your account login): nordaccount.com -> NordVPN -> Manual setup.
# The old ones are in the repo's git history: generate new ones.
NORDVPN_SERVICE_USER=
NORDVPN_SERVICE_PASSWORD=
VPN_COUNTRIES=Switzerland,Netherlands

# --- Filled in after first start (each app: Settings -> General -> API Key) ---
# Used only by arr-readonly, YETI's read-only download-status proxy.
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=
CHAPTARR_API_KEY=

# Jellydash: a Jellyfin API key (Jellyfin -> Dashboard -> API Keys) and Seerr's API key
# (Seerr -> Settings -> General). JELLYFIN_LINK_URL: https://jellyfin.home.<your domain>
JELLYDASH_JELLYFIN_API_KEY=
SEERR_API_KEY=
JELLYFIN_LINK_URL=
JELLYDASH_ADMIN_USER=admin
JELLYDASH_ADMIN_PASSWORD=

# Suwayomi (manga) login
SUWAYOMI_USER=admin
SUWAYOMI_PASSWORD=

# Komf: Kavita API key (Kavita -> your user -> Settings -> API Key) and a free ComicVine key
# (comicvine.gamespot.com/api). The same ComicVine key goes into Mylar3's settings.
KAVITA_API_KEY=
COMICVINE_API_KEY=
