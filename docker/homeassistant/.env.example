TZ=Europe/Dublin
APPDATA=${HOME}/volumes

# MQTT login shared by Home Assistant and Zigbee2MQTT (create it with the command in the README)
MQTT_USER=homeassistant
MQTT_PASSWORD=

# The dongle's stable path: run  ls /dev/serial/by-id/  once it's plugged in
ZIGBEE_DEVICE=/dev/serial/by-id/usb-Nabu_Casa_ZBT-2_REPLACE_ME-if00
