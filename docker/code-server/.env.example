TZ=Europe/Dublin
PUID=1000
PGID=1000
APPDATA=${HOME}/volumes
PROXY_DOMAIN=code.home.example.com

# Password hash (argon2), so the password itself isn't stored. Make one with:
#   echo -n 'your-password' | docker run --rm -i node:22-alpine npx -y argon2-cli -e
# Paste the output here with every $ doubled ($ -> $$), because Compose reads $ as a variable.
HASHED_PASSWORD=
