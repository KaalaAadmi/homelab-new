# From Immich's official example.env (current release), with homelab paths.
UPLOAD_LOCATION=${HOME}/data/immich
DB_DATA_LOCATION=${HOME}/volumes/immich/postgres
TZ=Europe/Dublin
IMMICH_VERSION=v3

# Letters and numbers only (A-Za-z0-9), no spaces or symbols.
DB_PASSWORD=

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
